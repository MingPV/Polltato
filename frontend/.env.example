# CloudPoll Go API (see backend APP_PORT, default 8000)
VITE_APP_API_URL=http://localhost:8000/api/v1
# Set false to use the real backend; true uses MSW (tests always use MSW)
VITE_APP_ENABLE_API_MOCKING=false
# Backend must set CORS_ORIGIN to this dev URL (e.g. http://localhost:3000) for cookie auth
