APP_PORT=8000
GRPC_PORT=50052

DB_PORT=5432
DB_HOST=localhost
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydatabase

DB_TEST_PORT=5433
DB_TEST_HOST=localhost
DB_TEST_USER=myuser
DB_TEST_PASSWORD=mypassword
DB_TEST_NAME=testdatabase

JWT_SECRET=myjwtsecret
JWT_EXPIRATION=3600

APP_ENV=development
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=http://localhost:4566 # Optional for LocalStack/Minio

# Comma-separated origins for browser credentialed requests (cookie auth).
# Also used for Socket.IO (Engine.IO) responses on APP_PORT at /socket.io/
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000